DEBUG=1
SECRET_KEY=your_secret_key_here
POSTGRES_DB=isoko_hub_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Sécurité SaaS (prod)
# DEBUG=0
# ALLOWED_HOSTS=api.isokohub.bi,localhost
# CORS_ALLOWED_ORIGINS=https://app.isokohub.bi
# CORS_ALLOW_ALL=0
# SECURE_SSL=1
# SECURE_SSL_REDIRECT=1
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=7
# THROTTLE_ANON=120/min
# THROTTLE_USER=600/min
# En DEBUG : throttle désactivé (config.throttling.Soft*)
# En production (DEBUG=0) : rates ci-dessus appliquées
# BACKUP_RETENTION_DAYS=14

# --- Email Gmail (recommandé — messages sur le téléphone) ---
# 1. Validation en 2 étapes : https://myaccount.google.com/security
# 2. Mot de passe d'application : https://myaccount.google.com/apppasswords
# 3. DEFAULT_FROM_EMAIL doit être identique à EMAIL_HOST_USER
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=votre.email@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=votre.email@gmail.com

# --- Alternative dev : Mailpit (http://localhost:8025) ---
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025
# EMAIL_USE_TLS=0

# URL du frontend (lien dans les emails d'approbation)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- OAuth social (inscription / connexion) ---
# Redirect URI à enregistrer chez chaque fournisseur :
#   http://localhost:8000/api/v1/accounts/oauth/google/callback/
#   http://localhost:8000/api/v1/accounts/oauth/facebook/callback/
#   http://localhost:8000/api/v1/accounts/oauth/github/callback/
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# FACEBOOK_OAUTH_CLIENT_ID=
# FACEBOOK_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# --- BurundiPay abonnements SaaS (Entreprise → marchand Isoko Hub) ---
# Stub=1 : simulation PIN sans API réelle (dev uniquement)
# En production (DEBUG=0) : BURUNDIPAY_STUB=0 + API_URL/KEY obligatoires
# (sauf BURUNDIPAY_ALLOW_STUB_IN_PROD=1 pour un staging contrôlé)
BURUNDIPAY_STUB=1
BURUNDIPAY_MERCHANT_ACCOUNT=ISOKO_HUB_MERCHANT
# BURUNDIPAY_API_URL=https://api.exemple-burundipay.bi
# BURUNDIPAY_API_KEY=
# BURUNDIPAY_WEBHOOK_SECRET=change-me
# URL publique reçue par BurundiPay après paiement (webhook Isoko)
# BURUNDIPAY_CALLBACK_URL=https://votredomaine.bi/api/v1/businesses/payments/burundipay/webhook/
# Chemins API (adapter au contrat du partenaire / agrégateur)
# BURUNDIPAY_COLLECT_PATH=/v1/collections
# BURUNDIPAY_STATUS_PATH=/v1/collections/{id}
# BURUNDIPAY_REFUND_PATH=/v1/refunds
# BURUNDIPAY_HTTP_TIMEOUT=30
# BURUNDIPAY_ALLOW_STUB_IN_PROD=0
